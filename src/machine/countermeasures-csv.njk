---
permalink: /countermeasures.csv
eleventyExcludeFromCollections: true
---
date,type,target,claim_id,status,replied,reference,claim_url
{% for e in countermeasures.actions %}{% set firstId = e.claims | first %}{% set claim = published.claimLinks | whereEq('id', firstId) | first %}{{ e.date | csvCell }},{{ e.type | csvCell }},{{ e.target | csvCell }},{{ (e.claims | join(";")) | csvCell }},{{ e.status | csvCell }},{{ ("yes" if e.replied else "no") | csvCell }},{{ e.reference | default("") | csvCell }},{{ (site.url + claim.url) | csvCell if claim else "" }}
{% endfor %}
