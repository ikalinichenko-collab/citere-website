---
permalink: /sitemap-registry.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for claim in claims %}
  <url><loc>{{ site.url }}{{ claim.url }}</loc><lastmod>{{ claim.updated | isoDate }}</lastmod></url>
  <url><loc>{{ site.url }}{{ claim.escalationUrl }}</loc><lastmod>{{ claim.updated | isoDate }}</lastmod></url>
{%- endfor %}
{%- for report in published.list %}
  <url><loc>{{ site.url }}/registry/{{ report.slug }}/</loc><lastmod>{{ report.publishedAt | isoDate }}</lastmod></url>
{%- endfor %}
{%- for f in published.facetEntries %}{% if f.lang == "en" %}
  <url><loc>{{ site.url }}{{ f.url }}</loc></url>
{%- endif %}{% endfor %}
</urlset>
