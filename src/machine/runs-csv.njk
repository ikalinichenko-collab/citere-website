---
permalink: /runs.csv
eleventyExcludeFromCollections: true
---
{#- Run keys frozen in published Claim Reports. Seed grid runs are not exported. -#}
run_id,cluster_id,markets,collected_at,claims,models,personas,per_run,catalog_version,grid_version,judge_version,watchlist_version,judge_validation,claim_keys
{% for run in runs.all %}{{ run.run_id | csvCell }},{{ run.cluster | csvCell }},{{ (run.markets or []) | join(" ") | csvCell }},{{ run.collected_at | csvCell }},{{ run.claims_count | csvCell }},{{ (run.models or []) | join(" ") | csvCell }},{{ (run.personas or []) | join(" ") | csvCell }},{{ run.per_run | default("") | csvCell }},{{ (run.versions.catalog if run.versions else "") | csvCell }},{{ (run.versions.grid if run.versions else "") | csvCell }},{{ (run.versions.judge if run.versions else "") | csvCell }},{{ (run.versions.watchlist if run.versions else "") | csvCell }},{{ (run.judge_validation.status if run.judge_validation else "") | csvCell }},{{ (run.claim_keys or []) | join(" ") | csvCell }}
{% endfor %}
