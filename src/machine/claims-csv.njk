---
permalink: /claims.csv
eleventyExcludeFromCollections: true
---
{#- One row per published Claim Report. Seed claim cards are not exported. -#}
claim_id,slug,cluster_id,label,verdict,published_at,splice,bots_tested,answers,countries,repeated_fake,critical,sources_identified,countermeasures_taken,url
{% for r in published.index %}{{ r.claimKey | csvCell }},{{ r.slug | csvCell }},{{ r.clusterName | csvCell }},{{ r.label | csvCell }},{{ r.verdict | csvCell }},{{ r.publishedAt | csvCell }},{{ r.splice | csvCell }},{{ r.strip.botsTested }},{{ r.strip.answers }},{{ r.strip.countries }},{{ r.strip.repeatedFake }},{{ r.strip.critical }},{{ r.strip.sourcesIdentified }},{{ r.strip.countermeasuresTaken }},{{ (site.url + '/registry/' + r.slug + '/') | csvCell }}
{% endfor %}
