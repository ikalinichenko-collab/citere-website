---
permalink: /sources.stix.json
eleventyExcludeFromCollections: true
---
{"type":"bundle","id":"bundle--{{ site.domain | stixId | replace("indicator--", "") }}","objects":[{% for s in publishedSources %}{"type":"indicator","spec_version":"2.1","id":"{{ s.domain | stixId }}","created":"{{ (s.first_seen or site.last_update) | isoDate }}T00:00:00.000Z","modified":"{{ site.last_update | isoDate }}T00:00:00.000Z","name":{{ s.domain | dump | safe }},"description":{{ ((s.label | default(s.domain)) + " - domain from the " + (s.network | networkName) + " network, recorded in AI chatbot citations by " + site.org.name + ".") | dump | safe }},"indicator_types":["misinformation"],"pattern":{{ ("[domain-name:value = '" + s.domain + "']") | dump | safe }},"pattern_type":"stix","valid_from":"{{ (s.first_seen or site.last_update) | isoDate }}T00:00:00.000Z","x_citere_network":{{ s.network | dump | safe }},"x_citere_citations":{{ s.citedCount }},"x_citere_cited_in":{{ s.cited_in | default([]) | dump | safe }},"x_citere_demo":{{ "true" if site.isDemo else "false" }},"external_references":[{"source_name":"citere","url":{{ (site.url + s.url) | dump | safe }}}]}{% if not loop.last %},{% endif %}{% endfor %}]}
