---
pagination:
  data: localised.sources
  size: 1
  alias: entry
layout: layouts/base.njk
wrap: wrap-narrow
permalink: "{{ entry.url }}"
---
{%- from "partials/bot-mark.njk" import botMark -%}
<div class="phead"><h1 style="font-family:ui-monospace,monospace;font-size:26px">{{ source.defanged }}</h1>
  {%- set named = source.network and source.network not in ["outlet", "other"] %}
  <p class="plead">
    {%- if source.label %}<b>{{ source.label }}</b>{% endif %}
    {%- if named %}{{ ". Part" if source.label else "Part" }} of the <b>{{ source.network | networkName }}</b> network{% endif %}
    {%- if source.attribution | length %}{% if source.label or named %}, publicly attributed by {% else %}Publicly attributed by {% endif %}
    {%- for a in source.attribution %} {% if a.url %}<a href="{{ a.url }}" style="color:var(--accent);font-weight:600">{{ a.org }}</a>{% else %}{{ a.org }}{% endif %}
    {%- if a.date %} ({{ a.date | displayDate }}){% endif %}{% if not loop.last %} and{% endif %}{% endfor %}{% endif %}
    {%- if source.label or named or source.attribution | length %}.{% endif %}
    {%- if source.first_seen %} We first observed it cited in a chatbot answer on
    <time datetime="{{ source.first_seen | isoDate }}">{{ source.first_seen | displayDate }}</time>.{% endif %}
    {%- if source.note_en %} {{ source.note_en | defangCopy }}{% endif %}</p></div>

<div class="tiles" style="margin:-8px 0 20px">
  {%- if source.category %}<span class="tile">{{ source.category | replace("_", " ") }}</span>{% endif %}
  {%- if source.language %}<span class="tile">{{ source.language | upper }}</span>{% endif %}
  {%- if source.first_seen %}<span class="tile">first cited {{ source.first_seen | monthLabel }}</span>{% endif %}
  <span class="tile">{{ source.status }}</span>
  {%- if source.rating %}<span class="tile" title="Third-party credibility rating (Iffy Index), advisory only">{{ source.rating.label }}{% if source.rating.level %} &middot; {{ source.rating.level }}{% endif %}</span>{% endif %}
</div>

<div class="metrics" style="grid-template-columns:repeat(5,1fr);margin:0 0 34px">
  <div class="m"><div class="n num">{{ source.citedCount }}</div><div class="l">answers cited it</div>
    <div class="s">once per answer, however many links</div></div>
  <div class="m"><div class="n num">{{ source.claimsReached | length }}</div><div class="l">claims reached</div>
    <div class="s">{{ source.claimsDistributed | length }} it is recorded as carrying</div></div>
  <div class="m"><div class="n num" style="color:var(--false)">{{ source.injectionCount }}</div>
    <div class="l">source-to-answer lines</div><div class="s">carried it and was cited on it</div></div>
  <div class="m"><div class="n num" style="color:var(--false)">{{ source.criticalCount }}</div>
    <div class="l">critical incidents</div><div class="s">cited while repeating a claim</div></div>
  <div class="m"><div class="n num">{{ source.citedBy | length }}</div><div class="l">assistants cited it</div>
    <div class="s">{% for b in source.citedBy | take(3) %}{{ b | botName }}{% if not loop.last %}, {% endif %}{% endfor %}</div></div>
</div>

{%- if source.claimsDistributed | length %}
<h2 id="distributed" style="margin:0 0 12px">Claims this domain carried</h2>
<div class="panel"><table>
  <caption class="visually-hidden">Claims this domain published, and whether an assistant later cited it while answering about them</caption>
  <thead><tr><th scope="col">{{ 'col.claim' | t }}</th><th scope="col">{{ 'col.verdict' | t }}</th><th scope="col" class="num">Cited on it</th><th scope="col">Source-to-answer line</th></tr></thead>
  <tbody>
  {%- for c in source.claimsDistributed %}
    <tr><td class="cl"><a href="{{ c.url | url }}">&ldquo;{{ c.title_en }}&rdquo;</a></td>
      <td><span class="badge {{ c.verdict | verdictClass }}">{{ c.verdict | verdictLabel }}</span></td>
      <td class="num">{{ source.byClaim[c.id] | default(0) }}</td>
      <td>{% if source.byClaim[c.id] %}<b style="color:var(--false)">yes</b>{% else %}<span style="color:var(--dimmer)">published, not cited</span>{% endif %}</td></tr>
  {%- endfor %}
  </tbody></table></div>
<p class="note">A source-to-answer line means this domain published the falsehood <i>and</i> an assistant
  cited it while answering about that same falsehood.</p>
{%- endif %}

{%- if source.claimsReachedOnly | length %}
<h2 id="where-cited" style="margin:36px 0 12px">Cited on claims it did not carry</h2>
<div class="panel"><table>
  <caption class="visually-hidden">Claims where assistants cited this domain although it is not recorded as having published them</caption>
  <thead><tr><th scope="col">{{ 'col.claim' | t }}</th><th scope="col">{{ 'col.verdict' | t }}</th><th scope="col" class="num">Citations</th><th scope="col">{{ 'col.citedBy' | t }}</th></tr></thead>
  <tbody>
  {%- for c in source.claimsReachedOnly %}
    <tr><td class="cl"><a href="{{ c.url | url }}">&ldquo;{{ c.title_en }}&rdquo;</a></td>
      <td><span class="badge {{ c.verdict | verdictClass }}">{{ c.verdict | verdictLabel }}</span></td>
      <td class="num">{{ source.byClaim[c.id] | default(0) }}</td>
      <td style="color:var(--dim)">{{ source.citedBy | length }} assistants</td></tr>
  {%- endfor %}
  </tbody></table></div>
<p class="note">These are candidates for the claim card: the domain reached an answer about a claim we have
  not recorded it as distributing.</p>
{%- endif %}

{%- if source.citedCount %}
<h2 id="by-persona" style="margin:36px 0 12px">Cited by assistant and question type</h2>
<div class="panel"><table>
  <caption class="visually-hidden">Citation counts per assistant and question type. Counts only: a share would need a denominator that lives in the metrics store.</caption>
  <thead><tr><th scope="col">{{ 'col.chatbot' | t }}</th>{% for p in metrics.dimensions.personas %}<th scope="col" class="num">{{ p }}</th>{% endfor %}<th scope="col" class="num">Total</th></tr></thead>
  <tbody>
  {%- for bot, n in source.byBot %}
    <tr><th scope="row" style="font-weight:400">{{ bot | botName }}</th>
      {%- for p in metrics.dimensions.personas %}<td class="num" data-persona="{{ p }}" style="color:var(--dim)">{{ source.grid[bot][p] | default(0) }}</td>{% endfor %}
      <td class="num"><b>{{ n }}</b></td></tr>
  {%- endfor %}
  </tbody></table></div>
<p class="note">Counts of answers, one per answer per domain. Persona columns are never summed into a
  single figure, and a citation count is not a rate: the denominator lives in the metrics store.</p>
{%- endif %}

{%- if source.claimsInjection | length %}
<h2 id="injection-lines" style="margin:36px 0 6px">Source-to-answer lines</h2>
<p class="note" style="margin:0 0 14px">Claims this domain both published and was cited on by an assistant
  answering about them. This is the strongest single piece of evidence the registry produces.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Claims where this domain both carried the falsehood and was cited by an assistant answering about it</caption>
  <thead><tr><th scope="col">{{ 'col.claim' | t }}</th><th scope="col">{{ 'col.verdict' | t }}</th>
    <th scope="col" class="num">Citations here</th><th scope="col" class="num">While repeating</th></tr></thead>
  <tbody>
  {%- for c in source.claimsInjection %}
    <tr><th scope="row" style="font-weight:400" class="cl"><a href="{{ c.url | url }}">&ldquo;{{ c.title_en }}&rdquo;</a></th>
      <td><span class="badge {{ c.verdict | verdictClass }}">{{ c.verdict | verdictLabel }}</span></td>
      <td class="num">{{ source.byClaim[c.id] | default(0) }}</td>
      <td class="num"><b style="color:var(--false)">{{ source.verdicts.repeat }}</b></td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

{%- if source.citedCount %}
<h2 id="by-market" style="margin:36px 0 6px">By market</h2>
<p class="note" style="margin:0 0 14px">Where the citations happened. Counts, never merged into one figure.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Citations of this domain per market</caption>
  <thead><tr><th scope="col">Market</th><th scope="col" class="num">Citations</th>
    <th scope="col">Share of this domain's citations</th></tr></thead>
  <tbody>
  {%- for market, n in source.byMarket %}
    <tr><th scope="row" style="font-weight:400">{{ market | upper }}</th>
      <td class="num">{{ n }}</td>
      <td><span class="barm" style="max-width:220px"><i style="width:{{ n | barWidth(source.citedCount) }}%"></i></span></td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- if source.markets | length == 1 %}
<p class="note">Every recorded citation of this domain came from one market: it is local to
  {{ source.markets[0] | upper }}.</p>
{%- endif %}

<h2 id="by-run" style="margin:36px 0 6px">Over time</h2>
<p class="note" style="margin:0 0 14px">Citations per run. Search-grounded assistants reshuffle their
  sources between runs for reasons unrelated to anything we do, so a movement here is not on its own a
  finding.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Citations of this domain per run</caption>
  <thead><tr><th scope="col">Run</th><th scope="col" class="num">Citations</th></tr></thead>
  <tbody>
  {%- for run, n in source.byRun %}
    <tr><th scope="row" style="font-weight:400">{{ run }}</th><td class="num">{{ n }}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- else %}
<h2 id="by-market" style="margin:36px 0 6px">By market</h2>
<p class="note">No assistant has cited this domain in any run held here. It stays on the watchlist and is
  marked dormant.</p>
{%- endif %}

<h2 id="complaints" style="margin:36px 0 12px">{{ 'section.complaints' | t }}</h2>
{%- if source.complaints | length %}
<div class="panel">
  {%- for c in source.complaints %}
  <div class="actrow"><div class="what">{{ c.target | defangCopy }}<small>via public abuse contact</small></div>
    <span class="chip {{ 'ok' if c.status in ['acknowledged','actioned','completed','responded'] else ('wait' if c.status == 'submitted' else '') }}"><span class="dot"></span>{{ c.status | statusLabel }}</span>
    <div class="when"><time datetime="{{ c.date | isoDate }}">{{ c.date | shortDate }}</time></div></div>
  {%- endfor %}
</div>
<p class="note">We publish the fact, the recipient, the date and the status. We do not publish the
  content of a complaint.</p>
{%- else %}
<p class="note">We have filed no abuse complaint about this domain.</p>
{%- endif %}
<div style="height:40px"></div>
