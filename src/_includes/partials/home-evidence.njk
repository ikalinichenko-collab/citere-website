{%- from "partials/bot-mark.njk" import botMark -%}
{#- Homepage evidence blocks. Each renders only when its data exists, so the
    page fills in as claims and benchmarks land rather than showing a
    placeholder (CLAUDE.md 11.6). -#}

{%- if benchmarks.strip | length %}
{% include "partials/bot-strip.njk" %}
{%- endif %}

{%- if metricCards | length %}
{% include "partials/metric-cards.njk" %}
{%- endif %}

{%- if monitoredMarkets | length %}
<section>
  <div class="shead"><h2>{{ 'section.markets' | t }}</h2>
    {%- if navigation.has.countries %}<a href="{{ '/countries/' | url }}">{{ 'action.allCountries' | t }} &rarr;</a>{% endif %}</div>
  <p class="lead">A market is a country plus the language people ask in, so we ask in that language.
    Of the {{ marketCounts.total }} on the list, {{ marketCounts.measured }} have a completed run and carry
    what it found; {{ marketCounts.queued }} are queued and say so. Austria and Germany are separate markets
    that share a language.</p>
  <div class="grid4">
  {%- for c in monitoredMarkets %}
    {%- if c.url %}
    <a class="cc {{ c.iso }}" href="{{ c.url | url }}"><div><span class="flag">{{ c.iso | flag }}</span>
      <h3>{{ c.name }}</h3><div class="stat">{{ c.claims }} {{ c.claims | plural("claim", "claims") }} &middot;
        {{ c.answers }} answers &middot; {{ c.language | languageName }}</div></div>
      {%- if c.rate is not none %}
      <div class="ccrate" data-persona="{{ c.ratePersona }}"><b class="num">{{ c.rate | rate }}</b>
        <span>of news answers repeated a claim</span></div>
      {%- endif %}
      <div class="bots-mini">{% for b in c.bots %}{{ botMark(logos, b, "sm") }}{% endfor %}</div></a>
    {%- else %}
    <div class="cc {{ c.iso }} queued"><div><span class="ccflag"><span class="flag">{{ c.iso | flag }}</span><span class="ccchip">queued</span></span>
      <h3>{{ c.name }}</h3><div class="stat">{{ c.queued }} {{ c.queued | plural("claim", "claims") }} queued &middot;
        {{ c.botCount }} assistants &middot; {{ c.language | languageName }}</div></div>
      <div class="bots-mini">{% for b in c.bots %}{{ botMark(logos, b, "sm") }}{% endfor %}</div></div>
    {%- endif %}
  {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if claims | length %}
<section>
  <div class="shead"><h2>{{ 'section.latestFindings' | t }}</h2>
    <a href="{{ '/registry/' | url }}">All {{ claims | length }} {{ claims | length | plural("claim", "claims") }} &rarr;</a></div>
  <p class="lead">The claims we documented most recently. Each card carries our verdict, what is
    actually true underneath, and how many assistants stated it as fact anyway. Open one for the
    answers themselves: the question asked, the market, and what the assistant cited.</p>
  <div class="grid3">
  {%- for item in claims | take(6) %}
    <a class="fcard" href="{{ item.url | loc(lang) | url }}">
      <div class="fhead"><span class="badge {{ item.verdict | verdictClass }}">{{ item.verdict | verdictLabel }}</span>
        <span class="fclus">{{ clusters[item.cluster].name_en | default(item.cluster) }}</span></div>
      <h3>{{ item.titles[lang] | default(item.title_en) }}</h3>
      {%- if item.canonical_debunk %}
      <p class="ftruth"><b>What is true.</b> {{ item.canonical_debunk | truncate(150, false, "…") }}</p>
      {%- endif %}
      {%- if item.tested %}
      <div class="fstats">
        <span><b>{{ item.repeatedBy | length }} of {{ item.botsTested }}</b> assistants stated it as fact</span>
        <span>{% if item.counts.critical %}<b>{{ item.counts.critical }}</b> {{ item.counts.critical | plural("answer", "answers") }} also cited a listed source{% else %}no answer cited a listed source{% endif %}</span>
        <span><b>{{ item.markets | length }}</b> {{ item.markets | length | plural("market", "markets") }} tested</span>
      </div>
      {%- else %}
      <div class="fstats"><span>Catalogued, not yet put to an assistant</span></div>
      {%- endif %}
    </a>
  {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if rankingCards | length %}
<section>
  <div class="shead"><h2>{{ 'section.rankings' | t }}</h2>
    {%- if navigation.has.benchmarks %}<a href="{{ '/benchmarks/' | url }}">{{ 'action.allRankings' | t }} &rarr;</a>{% endif %}</div>
  <p class="lead">One run, read three ways: by country, by assistant, and by the kind of lie.
    Every figure is the share of answers that stated a false claim as fact, for one type of question.
    Question types are reported separately and never averaged together.</p>
  <div class="grid3">
  {%- for card in rankingCards %}
    {%- set lbRows = card.rows %}{% set lbTitle = card.title %}{% set lbSub = card.sub %}
    {%- set lbNote = card.note %}
    {%- set lbShowIdx = card.idx %}{% set lbShowBar = card.bar %}{% set lbFlag = card.flag %}
    {%- set lbMore = card.more %}{% set lbMoreLabel = card.moreLabel %}
    {% include "partials/leaderboard.njk" %}
  {%- endfor %}
  </div>
</section>
{%- endif %}
