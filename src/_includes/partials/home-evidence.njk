{%- from "partials/bot-mark.njk" import botMark -%}
{#- Homepage evidence blocks. Each renders only when its data exists, so the
    page fills in as claims and benchmarks land rather than showing a
    placeholder (CLAUDE.md 11.6). -#}

{%- if benchmarks.strip | length %}
{% include "partials/bot-strip.njk" %}
{%- endif %}

{%- if metricCards | length %}
{% include "partials/metric-cards.njk" %}
{%- endif %}

{%- if monitoredMarkets | length %}
<section>
  <div class="shead"><h2>{{ 'section.markets' | t }}</h2>
    {%- if navigation.has.countries %}<a href="{{ '/countries/' | url }}">{{ 'action.allCountries' | t }} &rarr;</a>{% endif %}</div>
  <p class="lead">A market is a country and the language people ask in. Where a run exists, the card says
    what it found; the rest are on the list and not yet measured.</p>
  <div class="grid4">
  {%- for c in monitoredMarkets %}
    {%- if c.url %}
    <a class="cc {{ c.iso }}" href="{{ c.url | url }}"><div><span class="flag">{{ c.iso | flag }}</span>
      <h3>{{ c.name }}</h3><div class="stat">{{ c.claims }} {{ c.claims | plural("claim", "claims") }} &middot;
        {{ c.answers }} answers &middot; {{ c.language | languageName }}</div></div>
      <div class="bots-mini">{% for b in c.bots %}{{ botMark(logos, b, "sm") }}{% endfor %}</div></a>
    {%- else %}
    <div class="cc soon"><div><span class="flag">{{ c.iso | flag }}</span>
      <h3>{{ c.name }}</h3><div class="stat">{{ c.language | languageName }} &middot; scheduled, not yet measured</div></div></div>
    {%- endif %}
  {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if claims | length %}
<section>
  <div class="shead"><h2>{{ 'section.latestFindings' | t }}</h2>
    <a href="{{ '/registry/' | url }}">All {{ claims | length }} {{ claims | length | plural("claim", "claims") }} &rarr;</a></div>
  {%- set tableClaims = claims | take(5) %}
  {%- set tableCaption = "The most recently updated claims" %}
  {%- set stackTotalOverride = (claims | first).botsTested %}
  {% include "partials/claims-table.njk" %}
</section>
{%- endif %}

{%- if rankingCards | length %}
<section>
  <div class="shead"><h2>{{ 'section.rankings' | t }}</h2>
    {%- if navigation.has.benchmarks %}<a href="{{ '/benchmarks/' | url }}">{{ 'action.allRankings' | t }} &rarr;</a>{% endif %}</div>
  <p class="lead">Every figure is computed from recorded answers and links to the run it came from.
    Personas are reported separately and never averaged.</p>
  <div class="grid3">
  {%- for card in rankingCards %}
    {%- set lbRows = card.rows %}{% set lbTitle = card.title %}{% set lbSub = card.sub %}
    {%- set lbShowIdx = card.idx %}{% set lbShowBar = card.bar %}{% set lbFlag = false %}
    {%- set lbMore = card.more %}{% set lbMoreLabel = card.moreLabel %}
    {% include "partials/leaderboard.njk" %}
  {%- endfor %}
  </div>
</section>
{%- endif %}
