{#- The countermeasures log (CLAUDE_CODE_BRIEF §4, Countermeasures Catalogue §1).
    Redesigned per docs/"Countermeasures — redesigned log": a row leads with the
    claim, the markets it covered are a mini-grid, the publication channels sit
    inline as brand icons. Rows group under their date; the date header is itself a
    <details>, so it folds its actions away — the latest date opens by default.
    Everything is native <details>, so the log works without any JavaScript
    (CLAUDE.md §2), and a draft is visibly not an action taken (catalogue §0).
    Shared by the main log, the facet pages and the per-claim escalation report, so
    every value is derived from the action row itself — titles come from the global
    published.claimLinks. The union and the date grouping are filters, because this
    nunjucks cannot assign to a namespace member inside the loop. -#}
{%- set cols = tableActions | cmMarketColumns %}
<div class="panel">
  {#- The soc-* glyphs these rows reference are declared once per page by
      partials/soc-sprite.njk, included near the top of <body> in base.njk. -#}
  <div style="overflow-x:auto"><div style="min-width:860px">
  <div class="cmhead">
    <span>#</span><span>Claim</span><span>Type</span><span>Markets</span><span>Stage</span><span>Channels</span><span></span>
  </div>
  {%- for g in tableActions | cmDateGroups %}
  <details class="cmgroup"{% if loop.first %} open{% endif %}>
    <summary class="cmgroup-sum">
      <svg class="cmgchev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
      <span class="cmg-date">{% if g.date %}<time datetime="{{ g.date | isoDate }}">{{ g.date | displayDate }}</time>{% else %}Not sent{% endif %}</span>
      <span class="cmg-n">{{ g.count }} {{ g.count | plural("action", "actions") }}</span>
    </summary>
    <div class="cmgroup-body">
    {%- for row in g.items %}
    {%- set a = row.action %}
    {%- set cl = published.claimLinks | whereEq('id', a.claims[0]) | first %}
    {%- set cells = a.market | cmMarkets %}
    {%- set selfDriven = a.typeClass in ['t-public','t-github','t-catalog','t-feed'] %}
    <details class="cmrow">
      <summary>
        <span class="cmnum">{% if row.n < 10 %}0{% endif %}{{ row.n }}</span>
        {%- if a.claims | length %}
        <a class="cmclaim" href="{{ (cl.url if cl else a.url) | url }}">
          <span class="cmclaim-t">{{ cl.title if cl else a.claims | join(", ") }}</span>
          <span class="cmclaim-id">{{ a.claims | join(", ") }}{% if a.subtypeLabel %} · {{ a.subtypeLabel }}{% endif %}</span>
        </a>
        {%- else %}
        <span class="cmclaim"><span class="cmclaim-t" style="color:var(--dimmer);font-weight:400">No claim attached</span></span>
        {%- endif %}
        <span><span class="cmtag {{ a.typeClass }}">{{ a.typeLabel }}</span></span>
        <span>
          {%- if cells | length %}
          <span class="cmgrid" title="{{ cells | length }} of {{ cols | length }} markets">
            {%- for code in cols %}<span class="cmcell{% if code in cells %} on{% endif %}">{{ code | locRegion }}</span>{% endfor %}
          </span>
          {%- else %}<span class="cmpub" style="font-size:12px">Global</span>{% endif %}
        </span>
        <span class="cmstage{% if a.taken %} ok{% endif %}">
          {%- if a.taken %}<span class="cmcheck"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span>{% endif %}{{ a.statusLabel }}
        </span>
        <span class="cmsocs">
          {%- if a.links | length %}{% for l in a.links %}{% set icon = l.platform | socIcon %}<a class="cmsoc" href="{{ l.url | extHref }}" aria-label="{{ l.platform }}">{% if icon %}<svg><use href="#{{ icon }}"></use></svg>{% else %}{{ l.platform | socMono }}{% endif %}</a>{% endfor %}{% else %}<span style="color:var(--dimmer)">&mdash;</span>{% endif %}
        </span>
        <svg class="cmchev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
      </summary>
      <div class="cmdetail">
        <div>
          <b>Evidence package</b>
          {%- for id in a.claims %}{% set link = published.claimLinks | whereEq('id', id) | first %}<a class="cmlink" href="{{ (link.url if link else a.url) | url }}">Open {{ id }} &rarr;</a>{% endfor %}
          {%- if not a.claims | length %}<span class="cmmute">No claim attached</span>{% endif %}
          {%- if a.target %}<span class="cmmute">{% if selfDriven %}Published on{% else %}Sent to{% endif %} {{ a.target | defangCopy }}</span>{% endif %}
          {%- if a.follow_up_due %}<span class="cmmute">Follow-up due <time datetime="{{ a.follow_up_due | isoDate }}">{{ a.follow_up_due | shortDate }}</time></span>{% endif %}
        </div>
        <div>
          <b>Markets measured</b>
          {%- if not cells | length %}<span class="cmmute">Global &mdash; every market this claim was tested in</span>
          {%- elif cells | length == cols | length %}<span class="cmpub">All {{ cols | length }} markets measured for this claim.</span>
          {%- else %}<span class="cmchips">{% for code in cells %}<span class="cmchip">{{ code }}</span>{% endfor %}</span>{% endif %}
        </div>
        <div>
          {%- if selfDriven %}
          <b>Publication</b>
          <span class="cmpub">{{ a.typeLabel }}{% if a.target %} on {{ a.target | defangCopy }}{% endif %}{% if a.date %} on <time datetime="{{ a.date | isoDate }}">{{ a.date | shortDate }}</time>{% endif %}{% if a.links | length %}, shared to {% for l in a.links %}{{ l.platform }}{% if loop.revindex0 == 1 %} and {% elif not loop.last %}, {% endif %}{% endfor %}{% endif %}.</span>
          {%- else %}
          <b>Submission and proof</b>
          <span class="cmpub">
          {%- if a.sent %}{{ a.sent | defangCopy }}<br>{% endif %}
          {%- if a.awaitingConfirmation %}<b>Drafted and waiting for a person to approve it.</b> Nothing has been sent.
          {%- elif a.scheduled %}Scheduled, not yet run.
          {%- elif a.status == "drafted" %}<b>Draft only.</b> Nothing has been sent, filed or published.
          {%- elif a.status == "responded" %}Sent, and the recipient replied. The correspondence itself is held internally and is not published.
          {%- elif a.status == "closed" %}Sent, now closed. Proof of submission is held internally and is not published.
          {%- elif a.status == "declined" %}Sent, and declined. The correspondence is held internally and is not published.
          {%- elif a.taken %}Sent, awaiting a reply. Proof of submission is held internally and is not published.
          {%- else %}<b>Draft only.</b> Nothing has been sent, filed or published.{% endif %}
          {%- if a.reference %}<br><span class="cmmute">Ref: {{ a.reference | defangCopy }}</span>{% endif %}
          {%- if a.domain %}<br>Source: {{ a.domain | defang }}{% if a.basis %} &mdash; {{ a.basis }}{% endif %}{% endif %}
          </span>
          {%- endif %}
        </div>
        {%- if a.pipeline and not selfDriven %}
        <div class="cmpipe">
          {%- for step in a.pipeline.steps %}<span class="cmstep{% if loop.index0 <= a.pipeline.stage %} on{% endif %}{% if step == 'Declined' %} bad{% endif %}">{{ step }}</span>{% endfor %}
        </div>
        {%- endif %}
      </div>
    </details>
    {%- endfor %}
    </div>
  </details>
  {%- endfor %}
  {%- if not tableActions | length %}
  <div class="summary-line" style="color:var(--dimmer)">No actions match this filter.</div>
  {%- endif %}
  </div></div>
</div>
<p class="note">We publish the fact, date, target and status of each countermeasure. We do not publish what
  was submitted, the proof of submission, correspondence with a platform, or the names of individuals.
  Nothing leaves Citere without a person approving it, so a draft is listed as a draft and is not counted
  as an action taken.</p>
