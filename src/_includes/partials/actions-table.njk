{#- The countermeasures log filtered to this claim. A draft is visibly not an
    action taken (Countermeasures Catalogue 0). -#}
<div class="panel">
  <div class="summary-line"><b>{{ claim.counts.actions }}</b> {{ claim.counts.actions | plural("countermeasure taken", "countermeasures taken") }}<span>&middot;</span><b>{{ claim.counts.responses }}</b> {{ claim.counts.responses | plural("response received", "responses received") }}{% if claim.remeasuredOn %}<span>&middot;</span>re-measured <b><time datetime="{{ claim.remeasuredOn | isoDate }}">{{ claim.remeasuredOn | displayDate }}</time></b>{% endif %}</div>
  {%- for a in claim.countermeasures %}
  <div class="actrow">
    <div class="what">{{ a.typeLabel }}{% if a.subtypeLabel %} &middot; {{ a.subtypeLabel }}{% endif %}<small>{{ a.target | defangCopy }}{% if a.market %} &middot; {{ a.market | upper }}{% endif %}</small></div>
    <span class="chip {{ 'ok' if a.status in ['responded','closed'] else ('wait' if a.status in ['submitted','pending_confirmation'] else '') }}"><span class="dot"></span>{{ a.statusLabel }}</span>
    <div class="when">{% if a.date %}<time datetime="{{ a.date | isoDate }}">{{ a.date | shortDate }}</time>{% else %}<span style="color:var(--dimmer)">not sent</span>{% endif %}</div>
  </div>
  {%- endfor %}
</div>
<p class="note">We publish the fact, date and status of each countermeasure. We do not publish what was
  submitted, the proof of submission, correspondence with platforms, or the names of individuals. Nothing
  leaves Citere without a person approving it first, so a draft is listed as a draft.</p>
