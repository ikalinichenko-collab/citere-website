{%- from "partials/bot-mark.njk" import markNotice -%}
<footer><div class="wrap">
    <div class="fcols">
      <div class="fcol fbrand">
        <div class="logo">{{ site.org.name }}</div>
        <p>{{ 'footer.blurb' | t }}</p>
      </div>
      {%- for col in navigation.footer %}
      <div class="fcol"><h2>{{ col.headingKey | t | safe }}</h2>
        {%- for item in col.links %}
        <a href="{{ (item.url if item.shared else (item.url | loc(lang))) | url }}">{{ ('nav.' + item.key) | t | safe }}</a>
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
    {%- if pageHasMarks %}
    {#- Trademark line, required on any page that shows a vendor mark. Driven
        off the rendered page, so it cannot drift out of step with the marks. -#}
    {{ markNotice(logos, lang | default("en")) }}
    {%- endif %}
    <div class="fbot">
      <span>&copy; {{ site.last_update | year }} {{ site.org.name }} &middot; {{ 'footer.licence' | t }} &middot; {{ 'footer.updated' | t }} <time datetime="{{ site.last_update | isoDate }}">{{ site.last_update | displayDate }}</time></span>
      {%- if navigation.legal | length %}
      <span class="legal">{% for item in navigation.legal %}<a href="{{ (item.url if item.shared else (item.url | loc(lang))) | url }}">{{ ('nav.' + item.key) | t | safe }}</a>{% endfor %}</span>
      {%- endif %}
    </div>
  </div></footer>
