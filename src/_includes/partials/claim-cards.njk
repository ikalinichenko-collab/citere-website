{#- One card per claim, used on the homepage and across the registry. Set
    cardClaims before including; set cardMeta to true to carry the registry's
    own fields (splice, lifecycle status, markets tested), which are what the
    filters above the grid select on. -#}
{%- if cardHeading %}<h2 style="margin:26px 0 12px">{{ cardHeading }}</h2>{% endif %}
<div class="grid3">
{%- for item in cardClaims %}
  <a class="fcard" href="{{ item.url | loc(lang) | url }}">
    <div class="fhead"><span class="badge {{ item.verdict | verdictClass }}">{{ item.verdict | verdictLabel }}</span>
      <span class="fclus">{{ clusters[item.cluster].name_en | default(item.cluster) }}</span></div>
    <h3>{{ item.titles[lang] | default(item.title_en) }}</h3>
    {%- if item.canonical_debunk %}
    <p class="ftruth"><b>What is true.</b> {{ item.canonical_debunk | truncate(150, false, "…") }}</p>
    {%- endif %}
    {%- if cardMeta %}
    <div class="fmeta">
      {%- if item.splice %}<span class="splicebadge sp-{{ item.splice }}">{{ item.splice }}</span>
      <span class="fmlab">{{ item.splice | spliceLabel }}</span>{% endif %}
      {%- if item.status_field %}<span class="statuspill st-{{ item.status_field }}">{{ item.status_field }}</span>{% endif %}
    </div>
    {%- endif %}
    {%- if item.tested %}
    <div class="fstats">
      <span><b>{{ item.repeatedBy | length }} of {{ item.botsTested }}</b> assistants stated it as fact</span>
      <span>{% if item.counts.critical %}<b>{{ item.counts.critical }}</b> {{ item.counts.critical | plural("answer", "answers") }} also cited a listed source{% else %}no answer cited a listed source{% endif %}</span>
      <span><b>{{ item.markets | length }}</b> {{ item.markets | length | plural("market", "markets") }} tested{% if cardMeta and item.markets | length %} &middot; {% for m in item.markets %}{{ m.split("-")[0] | upper }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</span>
    </div>
    {%- else %}
    <div class="fstats"><span>Catalogued, not yet put to an assistant</span></div>
    {%- endif %}
  </a>
{%- endfor %}
</div>
