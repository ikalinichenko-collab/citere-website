{#- One ClaimReview + one Article for a published Claim Report. The app owns the
    verdict; these reports are all FALSE (ratingValue 1 of 5). Appearances are the
    runs the claim was measured in, not individual answers. -#}
{%- set ratingValues = { "false": 1, "misleading": 2, "unsupported": 3 } -%}
{%- set appearances = [] -%}
{%- for rk in (p.meta.runKeys | default([])) -%}
{%- set appearances = (appearances.push({
  "@type": "CreativeWork",
  "name": "AI-assistant answers recorded in run " + rk
}), appearances) -%}
{%- endfor -%}
{%- set jsonldReview = {
  "@context": "https://schema.org",
  "@type": "ClaimReview",
  "url": site.url + page.url,
  "claimReviewed": report.label,
  "datePublished": articlePublished,
  "dateModified": articleModified,
  "inLanguage": lang | default("en"),
  "author": { "@type": "Organization", "name": site.org.name, "url": site.url },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": ratingValues[report.verdict] | default(1),
    "alternateName": report.verdict | verdictLabel,
    "bestRating": 5,
    "worstRating": 1
  },
  "itemReviewed": {
    "@type": "Claim",
    "name": report.label,
    "appearance": appearances
  }
} -%}
<script type="application/ld+json">{{ jsonldReview | compact | jsonld | safe }}</script>
{%- set jsonldArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": articleHeadline,
  "url": site.url + page.url,
  "datePublished": articlePublished,
  "dateModified": articleModified,
  "inLanguage": lang | default("en"),
  "author": { "@type": "Organization", "name": site.org.name, "url": site.url },
  "publisher": { "@type": "Organization", "name": site.org.name, "url": site.url },
  "isAccessibleForFree": true,
  "license": "https://creativecommons.org/licenses/by/4.0/"
} -%}
<script type="application/ld+json">{{ jsonldArticle | compact | jsonld | safe }}</script>
{#- Dataset for the report's measurement data (CLAUDE.md §7). distribution points
    at the two static exports this report already generates (published-report-json
    /csv → /registry/{slug}.json|.csv). Absolute URLs follow the canonical pattern:
    site.url already carries the path prefix, so the path is appended prefix-less
    (never the `| url` filter, which would prepend the prefix a second time). The
    nested array is assembled with push (not an inline literal) — the same pattern
    the ClaimReview appearances use, which Nunjucks renders reliably here. -#}
{%- set spatial = "" -%}
{%- if p.meta and p.meta.countries and p.meta.countries.length -%}{%- set spatial = p.meta.countries | join(", ") -%}{%- endif -%}
{%- set distribution = [] -%}
{%- set distribution = (distribution.push({ "@type": "DataDownload", "encodingFormat": "application/json", "contentUrl": site.url + "/registry/" + report.slug + ".json" }), distribution) -%}
{%- set distribution = (distribution.push({ "@type": "DataDownload", "encodingFormat": "text/csv", "contentUrl": site.url + "/registry/" + report.slug + ".csv" }), distribution) -%}
{%- set jsonldDataset = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": (articleHeadline or report.label) + " — measurement data",
  "description": "Per-assistant, per-persona, per-market results behind this claim report: repeat and contamination counts with Wilson intervals, and the sources cited.",
  "url": site.url + page.url,
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": { "@type": "Organization", "name": site.org.name, "url": site.url },
  "isAccessibleForFree": true,
  "datePublished": articlePublished,
  "dateModified": articleModified,
  "temporalCoverage": articlePublished,
  "spatialCoverage": spatial,
  "distribution": distribution
} -%}
<script type="application/ld+json">{{ jsonldDataset | compact | jsonld | safe }}</script>
