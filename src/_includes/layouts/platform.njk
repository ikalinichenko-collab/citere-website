---
layout: layouts/base.njk
wrap: wrap-narrow
---
{%- from "partials/bot-mark.njk" import botMark -%}
{%- from "partials/cleansing.njk" import deltaCell, deltaCaveats -%}
<div class="phead" style="display:flex;align-items:center;gap:16px">
  {{ botMark(logos, profile.key, "lg", true) }}
  <div><h1 style="font-size:29px;margin:0 0 4px">{{ profile.name }}</h1>
    <div style="font-size:14px;color:var(--dimmer)">{{ profile.company }} &middot; public consumer interface, not API</div></div>
</div>

<p class="plead" style="margin-bottom:28px">{%- if profile.worst %}In the
  <b>{{ profile.worst.run.collected_at | monthLabel }}</b> run, {{ profile.name }} repeated a documented
  false claim in <b>{{ profile.worst.headline.repeat_rate.rate | rate }}</b> of its substantive answers to
  {{ profile.persona }} news-style questions in <b>{{ profile.worst.name }}</b> &mdash; its worst market
  &mdash; and cited a watchlisted domain in
  <b>{{ profile.worst.headline.contamination_rate.rate | rate }}</b> of its answers there.
  {%- else %}No market has yet collected enough answers from {{ profile.name }} to report a rate.{% endif %}
  Markets are shown side by side below and never merged.
  {{ profile.company }} has been notified of every finding on this page that carries a date.</p>

{%- if profile.worst %}
<div class="metrics" style="grid-template-columns:repeat(3,1fr);margin:0 0 34px">
  <div class="m" data-persona="{{ profile.persona }}"><div class="n num">{{ profile.worst.headline.repeat_rate.rate | rate }}</div>
    <div class="l">repeat rate</div><div class="s">{{ profile.persona }} &middot; news-style &middot; {{ profile.worst.name }} &middot; n={{ profile.worst.headline.repeat_rate.n }}</div></div>
  <div class="m" data-persona="{{ profile.persona }}"><div class="n num">{{ profile.worst.headline.contamination_rate.rate | rate }}</div>
    <div class="l">source-contamination rate</div><div class="s">{{ profile.persona }} &middot; {{ profile.worst.name }} &middot; n={{ profile.worst.headline.contamination_rate.n }}</div></div>
  <div class="m"><div class="n num">{{ profile.claimsRepeated }}</div>
    <div class="l">claims repeated</div><div class="s">of {{ claims | length }} documented</div></div>
</div>
{%- endif %}

<h2 id="by-persona" style="margin:0 0 12px">{{ 'section.byQuestionType' | t }}</h2>
<p class="note" style="margin:0 0 12px">One table per market. Personas are never averaged and markets are
  never merged; every figure carries its interval and sample size.</p>
{%- for entry in profile.markets %}
<h3 class="ssub">{{ entry.name }} &middot; {{ entry.language | languageName }}
  <span style="color:var(--dimmer);font-weight:400">&middot; <time datetime="{{ entry.run.collected_at | isoDate }}">{{ entry.run.collected_at | shortDate }}</time></span></h3>
<div class="panel"><table>
  <caption class="visually-hidden">Repeat rate, contamination and refusals for this assistant in {{ entry.name }}, by question type</caption>
  <thead><tr><th scope="col">{{ 'col.persona' | t }}</th><th scope="col" class="num">{{ 'col.repeatRate' | t }}</th>
    <th scope="col" class="num">{{ 'col.contamination' | t }}</th><th scope="col" class="num">Refused</th>
    <th scope="col" class="num">Searched</th></tr></thead>
  <tbody>
  {%- for row in entry.personas %}
    <tr data-persona="{{ row.persona }}">
      <th scope="row" class="mono" style="font-size:12px;color:var(--dimmer);font-weight:400">{{ row.persona }} &middot; {{ row.persona | personaLabel }}</th>
      <td class="num"><span class="cellstat{% if row.repeat_rate.low_n %} lown{% endif %}">{{ row.repeat_rate.rate | rate }}<small>{{ row.repeat_rate.ci | ciLabel }} &middot; n={{ row.repeat_rate.n }}</small></span></td>
      <td class="num"><span class="cellstat{% if row.contamination_rate.low_n %} lown{% endif %}">{{ row.contamination_rate.rate | rate }}<small>n={{ row.contamination_rate.n }}</small></span></td>
      <td class="num"><span class="cellstat">{{ row.dodge_rate.rate | rate }}<small>n={{ row.dodge_rate.n }}</small></span></td>
      <td class="num" style="color:var(--dim)">{{ (row.n - row.counts.dodge) }} answers</td>
    </tr>
  {%- endfor %}
  </tbody></table></div>
{%- endfor %}

{%- if profile.trend | length %}
<h2 id="trend" style="margin:36px 0 12px">Change between runs</h2>
{%- for line in profile.trend %}
<div class="panel"><table>
  <caption class="visually-hidden">Repeat rate for this assistant across comparable runs in one market</caption>
  <thead><tr><th scope="col">Run</th><th scope="col" class="num">{{ 'col.repeatRate' | t }}</th><th scope="col">{{ 'col.change' | t }}</th></tr></thead>
  <tbody>
  {%- for point in line.points %}
    <tr data-persona="{{ profile.persona }}">
      <th scope="row" style="font-weight:400"><time datetime="{{ point.run.collected_at | isoDate }}">{{ point.run.collected_at | displayDate }}</time>
        <span style="color:var(--dimmer)">&middot; {{ point.run.country | countryName }}</span></th>
      <td class="num"><span class="cellstat{% if point.repeat_rate.low_n %} lown{% endif %}">{{ point.repeat_rate.rate | rate }}<small>{{ point.repeat_rate.ci | ciLabel }} &middot; n={{ point.repeat_rate.n }}</small></span></td>
      <td>{% if not loop.first %}{{ deltaCell(line.change) }}{% endif %}</td>
    </tr>
  {%- endfor %}
  </tbody></table></div>
{{ deltaCaveats(drift, [profile.key], profile.persona, line.market | upper) }}
{%- endfor %}
{%- endif %}

<h2 id="verdicts" style="margin:36px 0 6px">What it did with the claims</h2>
<p class="note" style="margin:0 0 14px">The four outcomes as shares of every valid answer, one row per
  question type per market. Never collapsed into one number: the question types trigger different failure
  modes, and averaging them describes nobody.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Share of answers by outcome, per market and question type</caption>
  <thead><tr><th scope="col">Market</th><th scope="col">{{ 'col.persona' | t }}</th>
    <th scope="col" class="num">Repeated</th><th scope="col" class="num">Hedged</th>
    <th scope="col" class="num">Refuted</th><th scope="col" class="num">Refused</th>
    <th scope="col">Distribution</th></tr></thead>
  <tbody>
  {%- for entry in profile.markets %}
  {%- for row in entry.personas %}
    <tr data-persona="{{ row.persona }}">
      <th scope="row" style="font-weight:400">{% if loop.first %}{{ entry.name }}{% endif %}</th>
      <td class="mono" style="font-size:12px;color:var(--dimmer)">{{ row.persona }} &middot; {{ row.persona | personaLabel }}</td>
      <td class="num">{{ row.verdict_shares.repeat.rate | rate }}</td>
      <td class="num">{{ row.verdict_shares.u_context.rate | rate }}</td>
      <td class="num">{{ row.verdict_shares.refute.rate | rate }}</td>
      <td class="num">{{ row.verdict_shares.dodge.rate | rate }}</td>
      <td><span class="vbar"><i class="s-rep" style="width:{{ row.verdict_shares.repeat.rate * 100 }}%"></i><i class="s-ctx" style="width:{{ row.verdict_shares.u_context.rate * 100 }}%"></i><i class="s-ref" style="width:{{ row.verdict_shares.refute.rate * 100 }}%"></i><i class="s-dod" style="width:{{ row.verdict_shares.dodge.rate * 100 }}%"></i></span></td>
    </tr>
  {%- endfor %}
  {%- endfor %}
  </tbody></table></div>
<p class="note vlegend"><i class="s-rep"></i>repeated <i class="s-ctx"></i>hedged
  <i class="s-ref"></i>refuted <i class="s-dod"></i>refused</p>

{%- if profile.hasRetrieval %}
<h2 id="retrieval" style="margin:36px 0 6px">Searching, and what it found</h2>
<p class="note" style="margin:0 0 14px">How often this assistant cited anything at all, and how often what
  it cited included a listed source. Contamination concentrates on news-style questions rather than hostile
  ones: an ordinary question sends the assistant to search, and search is where listed sources sit beside
  legitimate coverage.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Share of answers citing anything, and share citing a listed source, per market and question type</caption>
  <thead><tr><th scope="col">Market</th><th scope="col">{{ 'col.persona' | t }}</th>
    <th scope="col" class="num">Cited anything</th><th scope="col" class="num">Cited a listed source</th></tr></thead>
  <tbody>
  {%- for entry in profile.markets %}
  {%- for row in entry.personas %}
    <tr data-persona="{{ row.persona }}">
      <th scope="row" style="font-weight:400">{% if loop.first %}{{ entry.name }}{% endif %}</th>
      <td class="mono" style="font-size:12px;color:var(--dimmer)">{{ row.persona }}</td>
      <td class="num">{{ row.retrieval_rate.rate | rate }}</td>
      <td class="num"><span class="cellstat{% if row.contamination_rate.low_n %} lown{% endif %}">{{ row.contamination_rate.rate | rate }}<small>{{ row.contamination_rate.ci | ciLabel }} &middot; n={{ row.contamination_rate.n }}</small></span></td>
    </tr>
  {%- endfor %}
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

{%- if profile.cited | length %}
<h2 id="sources" style="margin:36px 0 6px">Sources it cites</h2>
<p class="note" style="margin:0 0 14px">Listed domains this assistant cited, from the sources registry.
  Counted once per answer per domain. Domains are printed defanged and never linked.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Listed domains cited by this assistant</caption>
  <thead><tr><th scope="col">{{ 'col.domain' | t }}</th><th scope="col">{{ 'col.network' | t }}</th>
    <th scope="col" class="num">Cited by this assistant</th><th scope="col" class="num">Critical incidents</th></tr></thead>
  <tbody>
  {%- for row in profile.cited %}
    <tr><th scope="row" style="font-weight:400"><span class="domain">{{ row.source.defanged }}</span></th>
      <td><span class="netchip {{ row.source.network | networkClass }}">{{ row.source.network | networkLabel }}</span></td>
      <td class="num">{{ row.cited }}</td>
      <td class="num">{% if row.source.criticalCount %}<b style="color:var(--false)">{{ row.source.criticalCount }}</b>{% else %}<span style="color:var(--dimmer)">0</span>{% endif %}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

<h2 id="drift" style="margin:36px 0 6px">Citation drift</h2>
<p class="note" style="margin:0 0 14px">The share of the domains an assistant cites that changes from one
  month to the next, for reasons unrelated to anything we or the platform do. This is an external figure,
  not one of ours &mdash; it is here because a change between our runs has to be read against it.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Published month-to-month citation drift by product</caption>
  <thead><tr><th scope="col">Product</th><th scope="col" class="num">Cited domains that change month to month</th></tr></thead>
  <tbody>
  {%- for p in drift.products %}
    <tr{% if p.key == profile.key %} style="font-weight:600"{% endif %}>
      <th scope="row" style="font-weight:inherit">{{ p.label }}{% if p.key == profile.key %} &mdash; this assistant{% endif %}</th>
      <td class="num">{{ p.rate | rate }}</td></tr>
  {%- endfor %}
  </tbody></table></div>
<p class="note">Source: {{ drift.source }}. {{ drift.note_en }}</p>

{%- if profile.gaps | length %}
<h2 id="markets" style="margin:36px 0 6px">Where it does worst</h2>
<p class="note" style="margin:0 0 14px">Markets whose intervals do not overlap at the news-style question:
  the only comparisons this page will call real.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Pairs of markets where this assistant's repeat rate differs significantly</caption>
  <thead><tr><th scope="col">Higher in</th><th scope="col" class="num">Repeat rate</th>
    <th scope="col">Lower in</th><th scope="col" class="num">Repeat rate</th><th scope="col" class="num">Ratio</th></tr></thead>
  <tbody>
  {%- for gap in profile.gaps %}
    <tr data-persona="{{ profile.persona }}">
      <th scope="row" style="font-weight:400">{{ gap.high.name }}</th>
      <td class="num"><span class="cellstat">{{ gap.high.headline.repeat_rate.rate | rate }}<small>{{ gap.high.headline.repeat_rate.ci | ciLabel }} &middot; n={{ gap.high.headline.repeat_rate.n }}</small></span></td>
      <td>{{ gap.low.name }}</td>
      <td class="num"><span class="cellstat">{{ gap.low.headline.repeat_rate.rate | rate }}<small>{{ gap.low.headline.repeat_rate.ci | ciLabel }} &middot; n={{ gap.low.headline.repeat_rate.n }}</small></span></td>
      <td class="num"><b>{{ gap.ratio | round(1) }}&times;</b></td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- else %}
<h2 id="markets" style="margin:36px 0 6px">Where it does worst</h2>
<p class="note">No two markets differ significantly for this assistant: every pair of intervals overlaps,
  so any difference between them is directional and this page does not claim it.</p>
{%- endif %}

{%- if profile.repeatedClaims | length %}
<h2 id="claims" style="margin:36px 0 12px">{{ 'section.claimsRepeated' | t }}</h2>
<div class="panel"><table>
  <caption class="visually-hidden">Documented claims this assistant stated as fact in at least one answer</caption>
  <thead><tr><th scope="col">{{ 'col.claim' | t }}</th><th scope="col">{{ 'col.verdict' | t }}</th><th scope="col">{{ 'col.cluster' | t }}</th></tr></thead>
  <tbody>
  {%- for item in profile.repeatedClaims %}
    <tr><td class="cl"><a href="{{ item.url | url }}">&ldquo;{{ item.title_en }}&rdquo;</a></td>
      <td><span class="badge {{ item.verdict | verdictClass }}">{{ item.verdict | verdictLabel }}</span></td>
      <td style="color:var(--dim)">{{ clusters[item.cluster].name_en | default(item.cluster) }}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

<h2 id="countermeasures" style="margin:36px 0 6px">{{ 'section.countermeasuresTo' | t }} {{ profile.company }}</h2>
{%- if profile.platformActions | length %}
<p class="note" style="margin:0 0 14px">Where the relationship with this platform stands on the escalation
  ladder. A rung is reached once something on it has been done; nothing leaves Citere without a person
  approving it, so a draft is shown as a draft.</p>
<div class="ladder">
{%- for rung in profile.ladder %}
  <details class="rung {{ rung.state }}"{% if rung.all | length %} open{% endif %}>
    <summary><span class="rdot"></span><b>{{ rung.label }}</b>
      <span class="rnote">{% if rung.done | length %}{{ rung.done | length }} taken{% if rung.drafted | length %}, {{ rung.drafted | length }} drafted{% endif %}
        {%- elif rung.drafted | length %}{{ rung.drafted | length }} drafted, none sent
        {%- else %}nothing of this kind sent to {{ profile.company }} yet{% endif %}</span>
      <span class="rstate">{{ rung.state }}</span></summary>
    <div class="rbody">
    {%- for a in rung.all %}
      <div class="actrow">
        <div class="what">{{ a.typeLabel }}{% if a.subtypeLabel %} &middot; {{ a.subtypeLabel }}{% endif %}
          <small>{% for id in a.claims %}{{ id }}{% if not loop.last %}, {% endif %}{% endfor %}
            {%- if a.market %} &middot; {{ a.market | upper }}{% endif %}</small></div>
        <span class="cmpill {{ a.statusClass }}">{{ a.statusLabel }}</span>
        <div class="when">{% if a.date %}<time datetime="{{ a.date | isoDate }}">{{ a.date | shortDate }}</time>{% else %}<span style="color:var(--dimmer)">not sent</span>{% endif %}</div>
      </div>
    {%- endfor %}
    {%- if not rung.all | length %}<p class="note" style="margin:0">Nothing of this kind has been sent to
      {{ profile.company }}.</p>{% endif %}
    </div>
  </details>
{%- endfor %}
</div>
<p class="note">We publish the fact, date and status of each countermeasure. We do not publish what was
  submitted, the proof of submission, correspondence with {{ profile.company }}, or the names of
  individuals.</p>
{%- else %}
<p class="note">We have sent {{ profile.company }} nothing about the findings on this page yet.</p>
{%- endif %}

<p class="note" style="margin-bottom:40px">We test the public consumer interface, not the API. Results
  reflect that product at that date and model version; they are not a claim about the underlying model
  in general.</p>
