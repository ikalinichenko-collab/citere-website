---
layout: layouts/base.njk
wrap: wrap-narrow
---
{%- from "partials/bot-mark.njk" import botMark -%}
<div class="phead"><h1>{{ report.title }}</h1>
  <p class="plead">{{ report.n_responses }} responses from {{ report.chatbots | length }} public AI
    assistants, tested in {% for c in report.countries %}{{ c | countryName }}{% if loop.revindex0 == 1 %} and {% elif not loop.last %}, {% endif %}{% endfor %}
    across {{ report.languages | length }} languages{% if report.period %} between {{ report.period }}{% endif %},
    against {{ published.index | length }} documented false claims about Ukraine.</p></div>

<div class="prose" style="max-width:none">
  <h2 id="key-findings">{{ 'section.keyFindings' | t }}</h2>
  {{ prose.sections['key-findings'].html | prefixLinks | defangCopy | safe }}
  {%- for id in prose.order %}
  {%- if id != 'key-findings' and id != 'limitations' %}
  <h2 id="{{ id }}">{{ prose.sections[id].title }}</h2>
  {{ prose.sections[id].html | prefixLinks | defangCopy | safe }}
  {%- endif %}
  {%- endfor %}
  <h2 id="results-by-chatbot">{{ 'section.resultsByChatbot' | t }}</h2>
</div>

<div class="panel"><table>
  <caption class="visually-hidden">Repeat-rate per assistant and per persona for this run, with the source-contamination share</caption>
  <thead><tr><th scope="col">{{ 'col.chatbot' | t }}</th>
    {%- for p in benchmarks.personas %}<th scope="col">{{ p }}</th>{% endfor %}
    <th scope="col">{{ 'col.contamination' | t }}</th></tr></thead>
  <tbody>
  {%- for bot in platformsReport.chatbots %}
    <tr><td class="cl"><span class="markcell">{{ botMark(logos, bot.key, "sm", true) }}{{ bot.name }}</span></td>
      {%- for p in benchmarks.personas %}
      {%- set cell = null %}
      {%- for m in bot.markets %}{% if m.headline and m.headline.persona == p %}{% set cell = m.headline %}{% endif %}{% endfor %}
      <td class="num" data-persona="{{ p }}">{% if cell %}{{ cell.repeat_rate.rate | rate }}{% else %}&mdash;{% endif %}</td>
      {%- endfor %}
      <td class="num">{% if bot.worst %}{{ bot.worst.headline.contamination_rate.rate | rate }}{% else %}&mdash;{% endif %}</td></tr>
  {%- endfor %}
  </tbody></table></div>
<p class="note">Columns are personas, reported separately and never averaged into a single score.
  P1 neutral, P2 topical news, P3 leading, P4 malicious.</p>

<div class="prose" style="max-width:none">
  <h2 id="limitations">{{ 'section.limitations' | t }}</h2>
  {{ prose.sections['limitations'].html | prefixLinks | defangCopy | safe }}
</div>

<div class="exports" style="margin:24px 0 40px">
  {%- if report.pdf_url and report.pdf_url != "#" %}<a href="{{ report.pdf_url }}">Download PDF</a><span>&middot;</span>{% endif %}
  {%- if datasets.has['registry-csv'] %}<a href="{{ '/registry.csv' | url }}">Dataset (CSV)</a><span>&middot;</span>{% endif %}
  {%- if report.doi %}<span>DOI {{ report.doi }}</span><span>&middot;</span>{% endif %}
  <a href="{{ '/methodology/' | url }}">Methodology</a></div>
