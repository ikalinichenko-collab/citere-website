---
layout: layouts/base.njk
wrap: wrap-narrow
---
{%- if langSwitch %}
<nav class="langswitch" aria-label="Language">
  {%- for code in build.languages %}
  <a href="{{ basePath | loc(code) | url }}"{% if code == lang %} class="on" aria-current="true"{% endif %} lang="{{ code }}">{{ "English" if code == "en" else "Українська" }}</a>
  {%- endfor %}
</nav>
{%- endif %}
<div class="phead"><h1>{{ h1 }}</h1>
  <p class="plead">{{ doc.data.lead | mdInline | safe }}</p></div>
{{ content | safe }}
<div class="prose">
{{ doc.html | fill(figures | default({})) | prefixLinks | defangCopy | safe }}
</div>
<div style="height:40px"></div>
