---
layout: layouts/base.njk
wrap: wrap-narrow
---
{%- from "partials/bot-mark.njk" import botMark -%}
{#- Claim Report, three layers, in the order of Citere_Claim_Report_Spec.md:
    why is this false, what did the chatbots do with it, show me, where did it
    come from, what are the numbers, what have we done. -#}
<div class="claimdoc">

{# ------------------------------------------------------ the claim, and the brief #}
<div class="phead chead">
  <div class="tiles">
    <span class="badge {{ claim.verdict | verdictClass }} bigbadge">{{ claim.verdict | verdictLabel }}</span>
    <a class="tile" href="{{ ('/registry/cluster/' + claim.cluster + '/') | url }}">{{ clusters[claim.cluster].name_en | default(claim.cluster) }}</a>
    {%- if claim.splice %}<a class="tile" href="{{ ('/registry/splice/' + claim.splice + '/') | url }}">Splice {{ claim.splice }} &middot; {{ claim.splice_label }}</a>{% endif %}
  </div>
  <h1 class="ctitle">&ldquo;{{ claim.titles[lang] | default(claim.title_en) }}&rdquo;</h1>
  <p class="cmeta">{{ claim.id }}
    <span>&middot;</span> Verdict <time datetime="{{ claim.verdict_date | isoDate }}">{{ claim.verdict_date | displayDate }}</time>
    <span>&middot;</span> Updated <time datetime="{{ claim.updated | isoDate }}">{{ claim.updated | displayDate }}</time>
    {%- if claim.status_field %} <span>&middot;</span> {{ claim.status_field }}{% endif %}
    {%- if claim.status %} <span>&middot;</span> {{ claim.status.label }}{% endif %}</p>
</div>

{#- The brief: what a reader wants before any table. Built from the record in
    claims.js, never typed here. -#}
<div class="brief">
  {%- if claim.brief.truth %}
  <div class="brow"><div class="blab">What is true</div><p>{{ claim.brief.truth }}</p></div>
  {%- endif %}
  {%- if claim.brief.origin %}
  <div class="brow"><div class="blab">How it was pushed</div><p>{{ claim.brief.origin | defangCopy }}</p></div>
  {%- endif %}
  <div class="brow"><div class="blab">What the assistants did</div><p>{{ claim.brief.assistants }}</p></div>
</div>

{%- if claim.tested %}
<div class="metrics cmetrics">
  <div class="m"><div class="n num">{{ claim.counts.observations }}</div><div class="l">answers recorded</div>
    <div class="s">{{ claim.botsTested }} assistants &middot; {{ claim.markets | length }} countries</div></div>
  <div class="m"><div class="n num">{{ claim.counts.repeated }}</div><div class="l">stated it as fact</div>
    <div class="s">across every question type</div></div>
  <div class="m"><div class="n num" style="color:var(--false)">{{ claim.counts.critical }}</div><div class="l">critical</div>
    <div class="s">repeated it and cited a listed source</div></div>
  <div class="m"><div class="n num"><a href="#what-we-did" style="color:inherit">{{ claim.counts.actions }}</a></div><div class="l">countermeasures taken</div>
    <div class="s">{{ claim.sourcesIdentified.traced | length + claim.sourcesIdentified.found | length }} sources identified</div></div>
</div>
{%- endif %}

{%- if claim.tested %}
<nav class="toc" aria-label="On this page" style="font-size:12.5px;color:var(--dim);margin:0 0 26px;display:flex;flex-wrap:wrap;gap:6px 14px">
  <a href="#why-this-is-false">Why this is false</a>
  <a href="#kind-of-lie">The kind of lie</a>
  <a href="#what-the-chatbots-did">What the assistants did</a>
  <a href="#evidence">The answers themselves</a>
  <a href="#by-market">Where it was repeated</a>
  <a href="#results-by-bot">Which assistant repeated it</a>
  <a href="#sources-identified">Which sites fed it</a>
  <a href="#what-we-did">What we did about it</a>
  <a href="#detail">Record and limits</a>
</nav>
{%- endif %}

{# ---------------------------------------- 1. why the claim is false #}

{# ------------------------------------------------------ Layer 2 #}
<h2 id="why-this-is-false">Why this is false</h2>
<p class="note">What the claim says, what is actually true, and the evidence for
  each point. Everything below this section is about how assistants handled it.</p>

<div class="prose" style="max-width:none">
  <h3 id="the-verdict" style="font-size:15px;margin:18px 0 6px">{{ 'claim.verdict' | t }}</h3>
  {{ prose.sections['verdict'].html | prefixLinks | defangCopy | safe }}

  <h3 id="what-is-true" style="font-size:15px;margin:22px 0 6px">{{ 'claim.whatIsTrue' | t }}</h3>
  {{ prose.sections['what-is-true'].html | prefixLinks | defangCopy | safe }}

  {%- if claim.grain_of_truth and benchmarks.headline %}
  <div class="callout">In {{ benchmarks.headline.run_label }}, chatbots refuted pure inventions
    <b>{{ benchmarks.headline.pure_refuted | rate }}</b> of the time, but repeated claims built on a
    grain of truth in <b>{{ benchmarks.headline.grain_repeated | rate }}</b> of non-evasive answers.</div>
  {%- endif %}

  {%- if claim.debunk_argument | length %}
  </div>
  <div class="panel"><table class="debunk">
    <caption class="visually-hidden">What the claim asserts, what is true instead, and the evidence for each</caption>
    <thead><tr><th scope="col" style="width:36%">The claim says</th><th scope="col">What is true</th><th scope="col" style="width:22%">Evidence</th></tr></thead>
    <tbody>
    {%- for row in claim.debunk_argument %}
      <tr><th scope="row" style="font-weight:400;color:var(--false)">{{ row.assertion }}</th>
        <td>{{ row.refutation }}</td>
        <td style="color:var(--dim);font-size:12.5px">{{ row.source }}</td></tr>
    {%- endfor %}
    </tbody></table></div>
  <div class="prose" style="max-width:none">
  {%- endif %}

  <h3 id="where-the-claim-comes-from" style="font-size:15px;margin:22px 0 6px">{{ 'claim.origin' | t }}</h3>
  {{ prose.sections['where-the-claim-comes-from'].html | prefixLinks | defangCopy | safe }}
  <p>First seen <time datetime="{{ claim.origin.first_seen | isoDate }}">{{ claim.origin.first_seen | displayDate }}</time>
    on the {{ claim.origin.network | networkName }} network{% if claim.origin.attribution | length %}, attributed by
    {% for a in claim.origin.attribution %}{% if a.url %}<a href="{{ a.url }}">{{ a.org }}</a>{% else %}{{ a.org }}{% endif %}
    (<time datetime="{{ a.date | isoDate }}">{{ a.date | displayDate }}</time>){% if not loop.last %} and {% endif %}{% endfor %}{% endif %}.</p>
</div>

{%- if claim.chain | length %}
<h3 class="ssub">How it moved</h3>
<div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:13px;margin-bottom:10px">
  {%- for node in claim.chain %}
  <span class="tile" style="{% if node.injection %}border-color:var(--false);color:var(--false);font-weight:600{% endif %}">{{ node.domain | defang }}<br>
    <small style="font-weight:400;color:var(--dimmer)"><time datetime="{{ node.date | isoDate }}">{{ node.date | shortDate }}</time></small></span>
  <span style="color:var(--dimmer)">&rarr;</span>
  {%- endfor %}
  <span class="tile">chatbot answers<br><small style="color:var(--dimmer)">{{ claim.runs[0].collected_at | monthLabel }}</small></span>
</div>
<p class="note">A domain shown in red both carried this claim and was later cited by an assistant
  answering about it &mdash; the source-to-answer line.</p>
{%- endif %}


{%- if claim.confirmations | length %}
<h3 class="ssub" id="who-else-has-checked-this">{{ 'claim.whoElse' | t }}</h3>
<div class="panel"><table>
  <caption class="visually-hidden">Independent organisations that reached the same conclusion</caption>
  <thead><tr><th scope="col">{{ 'col.organisation' | t }}</th><th scope="col">{{ 'col.finding' | t }}</th><th scope="col">{{ 'col.date' | t }}</th></tr></thead>
  <tbody>
  {%- for c in claim.confirmations %}
    <tr><td>{% if c.url %}<a href="{{ c.url }}">{{ c.org }}</a>{% else %}{{ c.org }}{% endif %}</td>
      <td style="color:var(--dim)">{{ c.finding_en }}</td>
      <td class="num" style="color:var(--dimmer)"><time datetime="{{ c.date | isoDate }}">{{ c.date | shortDate }}</time></td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

{# ---------------------------------------- 2. what kind of lie it is #}

{%- if claim.splice %}
<h2 id="kind-of-lie">The kind of lie: splice {{ claim.splice }} &mdash; {{ claim.splice_label }}</h2>
<p class="note">Every claim in the registry is classified by how the lie is attached to the truth. This one is splice {{ claim.splice }}, and assistants handle each kind differently: an outright invention usually gets refuted, a real event with one fact changed usually does not.</p>
<div class="panel" style="padding:16px 18px">
  <div class="tiles" style="margin-bottom:10px">
    <a class="tile" href="{{ ('/registry/splice/' + claim.splice + '/') | url }}">Splice {{ claim.splice }} &middot;
      {{ claim.splice_label }} &rarr;</a>
  </div>
  <p style="margin:0 0 10px;font-size:13.5px">The claim {{ claim.splice_lede }}</p>
  <p style="margin:0 0 10px;font-size:13.5px">{% if claim.splice == "D" %}Nothing in it happened. It
    survives because the story around it did: a real scandal, a real market, real names. An assistant that
    searches finds the setting and mistakes it for the event.{% else %}Most of the story is true, and that
    is what makes it hard. An assistant searching for the real event finds this version of it in the same
    results, and cannot tell which sentence is the forged one.{% endif %}</p>
  <p style="margin:0;font-size:13.5px;color:var(--dim)">Our questions on this claim therefore aim at
    {% if claim.splice == "A" %}the source and the actor{% elif claim.splice == "B" %}the inference, not the premise{% elif claim.splice == "C" %}currency and scale{% else %}whether the object exists at all{% endif %}.</p>
</div>
{%- endif %}

{# ---------------------------------------- 3. what the assistants did #}

{%- if claim.tested %}
<h2 id="what-the-chatbots-did">What the assistants did with it</h2>
<p class="note">Each assistant's behaviour on this claim in plain terms, worst
  first. Counts only in this section: the rates, with their intervals, are further down.</p>
{%- for bot in claim.botBlocks %}
<div class="panel botblock {% if bot.critical %}b-crit{% elif bot.repeat %}b-rep{% else %}b-clean{% endif %}">
  <div style="display:flex;align-items:center;gap:9px;margin-bottom:6px">
    {{ botMark(logos, bot.key, "sm", true) }}
    <b>{{ bot.name }} &mdash; {{ bot.repeat }} {{ bot.repeat | plural("repeat", "repeats") }} out of {{ bot.n }} answers{% if bot.critical %}, {{ bot.critical }} with a listed source cited{% endif %}</b>
  </div>
  <p style="margin:0;font-size:13.5px;color:var(--dim)">
    {%- if not bot.repeat %}It did not state the claim as fact in any market, under any of the four
      question types.
    {%- elif bot.dominantPersona == "P2" %}Most of its repeats came on news-style questions &mdash; the
      phrasing that sends an assistant to search, where this claim sits beside legitimate coverage of the
      same story.
    {%- elif bot.dominantPersona == "P3" %}Most of its repeats came where the question already assumed
      the claim. It accepted the premise rather than correcting it.
    {%- elif bot.dominantPersona == "P4" %}Most of its repeats came when asked to write the claim up,
      which it did without a disclaimer.
    {%- else %}Its repeats were spread across question types, including neutral ones.{% endif %}
    {%- if bot.critical %} In {{ bot.critical }} of them it also cited
      {% for d in bot.listedWhileRepeating %}{{ d.domain | defang }}{% if not loop.last %}, {% endif %}{% endfor %}.
    {%- elif bot.repeat %} It cited no listed source while doing so: this claim is coming out of the
      model, not out of a search result.{% endif %}
    {%- if bot.marketConcentrated and bot.worstMarket %} {{ bot.worstMarket.market | upper }} carries most
      of them.{% endif %}
  </p>
</div>
{%- endfor %}

<h3 class="ssub">What this shows</h3>
<p style="max-width:74ch">Listed domains were cited in {{ claim.pooled.contaminated }} of
  {{ claim.counts.observations }} answers. {% if claim.sourcesIdentified.injection %}{{ claim.sourcesIdentified.injection }}
  of the domains recorded as carrying this claim were cited by an assistant answering about it &mdash; a
  direct line from where the claim was published to what a user was told.{% else %}None of the domains
  recorded as carrying this claim was cited by an assistant answering about it: what repeats here comes
  out of the models, not out of a search result.{% endif %}</p>
{%- endif %}

{%- if claim.incidents | length %}
<h2 id="evidence">The answers themselves, one by one</h2>
<p class="note">Every answer in which an assistant stated the claim as fact:
  the question asked, what the assistant said, and what is actually true. Critical first &mdash; those
  are the answers that also cited a listed source. Showing all
  {{ claim.incidentCounts.critical }} critical and
  {{ claim.incidentCounts.shown - claim.incidentCounts.critical }} of
  {{ claim.incidentCounts.high }} high; the rest are in the per-claim export.</p>
{%- if claim.hasSyntheticText %}
<p class="note" data-notice="synthetic-quotes" style="border-left:3px solid var(--mislead);padding-left:10px;margin:0 0 14px">
  <b>Response text in this demo is generated from the claim card; real runs carry verbatim responses.</b>
  The question and the assistant's words below are built by template from this claim's own record, so they
  read like an exchange that never happened. Everything else on this page &mdash; which assistant, which
  market, which question type, what it cited, how it was coded &mdash; is from the run.</p>
{%- endif %}
{%- for incident in claim.incidents %}
{#- Collapsed by default: the summary is the gist - who, where, which question
    type, how serious, what it said and what it cited - and opening it gives
    the exchange with what is actually true beside it. -#}
<details class="evd {{ 'crit' if incident.tier == 'critical' else 'high' }}"{% if incident.synthetic %} data-synthetic="true"{% endif %}>
  <summary>
    <span class="evmeta" data-persona="{{ incident.persona }}">
      <b class="evtier {{ 'evc' if incident.tier == 'critical' else 'evh' }}">{{ incident.tier | upper }}</b>
      <b>{{ incident.chatbot | botName }}</b>
      <span>{{ incident.market | upper }}</span>
      <span>{{ incident.persona }} {{ incident.persona | personaLabel }}</span>
      <time datetime="{{ incident.date | isoDate }}">{{ incident.date | shortDate }}</time>
    </span>
    <span class="evgist">{% if incident.quote %}&ldquo;{{ incident.quote | defangCopy | truncate(120, true, "…") }}&rdquo;{% else %}Response text not published.{% endif %}</span>
    <span class="evsrc">{% if incident.listed | length %}Cited a listed source:
      {% for d in incident.listed %}<span class="domain">{{ d | defang }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
      {%- else %}No listed source &mdash; the claim came out of the model, not a search result{% endif %}</span>
  </summary>
  <div class="evbody">
    {%- if incident.prompt_text %}
    <div class="q"><b>Question asked:</b> {{ incident.prompt_text | defangCopy }}</div>
    {%- endif %}
    <div class="sbs">
      <div class="said"><small>What the assistant said</small>{{ incident.quote | defangCopy | default("Not published.") }}</div>
      <div class="truth"><small>What is actually the case</small>{{ claim.canonical_debunk }}</div>
    </div>
    <div class="evline"><b>Everything it cited:</b>
      {%- if incident.domains | length %} {% for d in incident.domains %}<span{% if d in incident.listed %} class="domain"{% endif %}>{{ d | defang }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
      {%- else %} nothing{% endif %}</div>
    <div class="evline">Repeat {{ incident.repeat_n }} of {{ claim.limitations.repeats }}
      {%- if incident.judge_confidence %} &middot; judge confidence {{ incident.judge_confidence }}{% endif %}
      &middot; {% if incident.review %}verified by a person{% else %}awaiting human review{% endif %}
      {%- if incident.is_live %} &middot; live formulation{% endif %}</div>
  </div>
</details>
{%- endfor %}
{%- endif %}

{# ---------------------------------------- 4. where, and which assistant #}

{%- if claim.marketSummary | length %}
<h2 id="by-market">Where it was repeated &mdash; by country and language</h2>
<p class="note">The same claim, put to the same assistants in each market, in that market&rsquo;s own language. Counts pool across assistants; the rate beside them is one question type, one market, one run, because that is the only shape a rate can have.</p>
<div class="panel"><table class="mkts">
  <caption class="visually-hidden">Answers, repeats and critical incidents on this claim by market</caption>
  <thead><tr><th scope="col">Market</th><th scope="col">Language</th><th scope="col" class="num">Answers</th>
    <th scope="col" class="num">Repeated</th><th scope="col" class="num">Critical</th>
    <th scope="col" class="num">Repeat rate, news question</th></tr></thead>
  <tbody>
  {%- for row in claim.marketSummary %}
    <tr data-persona="{{ row.persona }}">
      <th scope="row" style="font-weight:400">{{ row.country | countryName }}
        <small style="color:var(--dimmer)">{{ row.market | upper }}</small></th>
      <td style="color:var(--dim)">{{ row.language | languageName }}</td>
      <td class="num" style="color:var(--dim)">{{ row.n }}</td>
      <td class="num"><b>{{ row.repeat }}</b></td>
      <td class="num">{% if row.critical %}<b style="color:var(--false)">{{ row.critical }}</b>{% else %}<span style="color:var(--dimmer)">0</span>{% endif %}</td>
      <td class="num">{%- if row.rate %}<span class="cellstat{% if row.rate.low_n %} lown{% endif %}">{{ row.rate.rate | rate }}<small>{{ row.rate.ci | ciLabel }} &middot; n={{ row.rate.n }}</small></span>
        {%- else %}<span style="color:var(--dimmer)">&mdash;</span>{% endif %}</td></tr>
  {%- endfor %}
  </tbody></table></div>
<p class="note">Two markets can share a language and still differ: Germany and Austria are asked the same
  questions in German. Where two intervals overlap, the difference between those markets is not established
  at this sample size.</p>
{%- endif %}

{%- if claim.tested %}
<h2 id="results-by-bot">Which assistant repeated it</h2>
<p class="note">One row per assistant, one column per question type, inside one market and one run. Cells below n = 20 are greyed: at claim level this says which way a difference points, not that it is established.</p>
{% include "partials/observations-table.njk" %}

<h3 class="ssub" id="a-b-matrix" style="margin-top:26px">Every answer, by what it did and what it cited</h3>
<p class="note">Every answer placed by two things at once: what the assistant did
  with the claim, and whether it cited a listed source. The top-right cell is the one that matters.</p>
<div class="panel"><table>
  <caption class="visually-hidden">Answers by what the assistant did and whether it cited a listed source</caption>
  <thead><tr><th scope="col"></th><th scope="col" class="num">Source clean</th><th scope="col" class="num">Listed source cited</th></tr></thead>
  <tbody>
    <tr><th scope="row">REPEAT <small>stated it as fact</small></th>
      <td class="num"><b style="color:var(--mislead)">HIGH &middot; {{ claim.pooled.abx.repeat.clean }}</b></td>
      <td class="num"><b style="color:var(--false)">CRITICAL &middot; {{ claim.pooled.abx.repeat.listed }}</b></td></tr>
    <tr><th scope="row">U_context <small>repeated it, hedged</small></th>
      <td class="num">{{ claim.pooled.abx.u_context.clean }}</td>
      <td class="num"><b>REVIEW &middot; {{ claim.pooled.abx.u_context.listed }}</b></td></tr>
    <tr><th scope="row">REFUTE <small>corrected it</small></th>
      <td class="num">{{ claim.pooled.abx.refute.clean }}</td>
      <td class="num">LOW &middot; {{ claim.pooled.abx.refute.listed }}</td></tr>
    <tr><th scope="row">DODGE <small>avoided the question</small></th>
      <td class="num">{{ claim.pooled.abx.dodge.clean }}</td>
      <td class="num">{{ claim.pooled.abx.dodge.listed }}</td></tr>
  </tbody></table></div>
<p class="note">{{ claim.counts.observations }} valid answers &middot;
  {{ claim.limitations.unresolved }} unresolved, excluded &middot;
  {{ claim.limitations.quarantined }} quarantined, excluded.
  <b>CRITICAL</b> repeated the claim and cited a listed source. <b>HIGH</b> repeated it from the model's
  own memory, with no listed source. <b>REVIEW</b> hedged, but pulled a listed source into the answer.</p>

{%- endif %}

{%- if claim.sourcesIdentified.traced | length or claim.sourcesIdentified.found | length %}
<h2 id="sources-identified">Which sites fed it</h2>
<p class="note">{{ claim.sourcesIdentified.traced | length + claim.sourcesIdentified.found | length }}
  sources have been identified on this claim: {{ claim.sourcesIdentified.traced | length }} traced from where
  it first appeared, {{ claim.sourcesIdentified.found | length }} found because an assistant cited them while
  answering about it. {{ claim.sourcesIdentified.injection }} did both &mdash; that is the line from a
  publisher to an answer.</p>

{%- if claim.sourcesIdentified.traced | length %}
<h3 class="ssub">Traced from where the claim first appeared ({{ claim.sourcesIdentified.traced | length }})</h3>
<div class="panel"><table>
  <caption class="visually-hidden">Domains recorded as carrying this claim, and how often assistants cited them while answering about it</caption>
  <thead><tr><th scope="col">Domain</th><th scope="col">Carried it</th><th scope="col" class="num">Cited here</th>
    <th scope="col" class="num">While repeating</th><th scope="col">Source-to-answer line</th></tr></thead>
  <tbody>
  {%- for d in claim.sourcesIdentified.traced %}
    <tr><th scope="row" style="font-weight:400"><span class="domain">{{ d.domain | defang }}</span></th>
      <td class="num" style="color:var(--dimmer)">{% if d.date %}<time datetime="{{ d.date | isoDate }}">{{ d.date | shortDate }}</time>{% else %}&mdash;{% endif %}</td>
      <td class="num">{{ d.cited }}</td>
      <td class="num">{% if d.repeat %}<b style="color:var(--false)">{{ d.repeat }}</b>{% else %}0{% endif %}</td>
      <td>{% if d.injection %}<b style="color:var(--false)">yes</b>{% else %}<span style="color:var(--dimmer)">carried it, not cited on it</span>{% endif %}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

{%- if claim.sourcesIdentified.found | length %}
<h3 class="ssub">Found through assistant citations ({{ claim.sourcesIdentified.found | length }}) &mdash; not yet on the card</h3>
<div class="panel"><table>
  <caption class="visually-hidden">Listed domains assistants cited on this claim that the card does not record as carrying it</caption>
  <thead><tr><th scope="col">Domain</th><th scope="col" class="num">Cited</th><th scope="col" class="num">While repeating</th>
    <th scope="col">Note</th></tr></thead>
  <tbody>
  {%- for d in claim.sourcesIdentified.found %}
    <tr><th scope="row" style="font-weight:400"><span class="domain">{{ d.domain | defang }}</span></th>
      <td class="num">{{ d.cited }}</td>
      <td class="num">{% if d.repeat %}<b style="color:var(--false)">{{ d.repeat }}</b>{% else %}0{% endif %}</td>
      <td style="color:var(--dim);font-size:12.5px">candidate for the claim card</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}
<p class="note">Every domain here has its own record in the sources registry. Domains are printed
  defanged and never linked.</p>
{%- endif %}

{# ---------------------------------------- 5. what we did about it #}

<h2 id="what-we-did">What we did about it</h2>
<p class="note">The full ladder &mdash; what has been tried, what it unlocked and
  what is still blocked &mdash; is in this claim's <a href="{{ claim.escalationUrl | url }}">escalation report</a>.</p>
{%- if claim.countermeasures | length %}
{% include "partials/actions-table.njk" %}
{%- else %}
<p class="note">Nothing has been sent, filed or published on this claim yet.</p>
{%- endif %}

{%- if claim.cleansing | length %}
<h3 class="ssub" id="what-changed">{{ 'claim.whatChanged' | t }}</h3>
<p class="note">Where a market has been measured twice under the same grid, what
  the second run found beside the first.</p>
{% include "partials/before-after-table.njk" %}
{%- elif claim.tested %}
<h3 class="ssub" id="what-changed">{{ 'claim.whatChanged' | t }}</h3>
<p class="note">No market has yet been measured twice under the same grid with the same number of repeats,
  so there is nothing to compare. A trend appears after the second comparable run.</p>
{%- endif %}

{# ---------------------------------------- the record behind the page #}

{%- if claim.tested %}
<div class="appx">
<h2 id="detail">The record behind this page</h2>
<p class="note">Everything the page above is built from: the claim card the judge compares answers against, what this page cannot tell you, and how the measurement was made.</p>
{%- endif %}

{%- if claim.tested %}
<h3 class="ssub" id="claim-card" style="margin-top:26px">The claim card the judge compares answers against</h3>
<p class="note">The reference record the judge compares every answer against.
  Rendered from the claim's own entry, unedited.</p>
<div class="panel" style="padding:16px 18px">
  {%- if claim.false_claim %}
  <h3 class="ssub" style="margin-top:0">The false claim</h3>
  <blockquote style="margin:0 0 12px;padding-left:12px;border-left:3px solid var(--line2)">{{ claim.false_claim }}</blockquote>
  {%- endif %}
  <h3 class="ssub">What is actually the case</h3>
  <p style="margin:0 0 12px;font-size:13.5px">{{ claim.canonical_debunk }}</p>
  {%- if claim.surface_objects | length %}
  <h3 class="ssub">Where it spread</h3>
  <table>
    <caption class="visually-hidden">Domains, markers and artifacts recorded as carrying this claim</caption>
    <thead><tr><th scope="col">Object</th><th scope="col">Type</th><th scope="col">First seen</th><th scope="col">Found in</th></tr></thead>
    <tbody>
    {%- for o in claim.surface_objects %}
      <tr><th scope="row" style="font-weight:400"><span class="domain">{{ o.object | defang }}</span></th>
        <td style="color:var(--dim)">{{ o.type }}</td>
        <td class="num" style="color:var(--dimmer)">{% if o.date %}<time datetime="{{ o.date | isoDate }}">{{ o.date | shortDate }}</time>{% else %}&mdash;{% endif %}</td>
        <td style="color:var(--dim);font-size:12.5px">{{ o.found_in }}</td></tr>
    {%- endfor %}
    </tbody></table>
  {%- endif %}
</div>
{%- endif %}

{%- if claim.tested %}
<div class="panel" style="padding:14px 16px;margin-bottom:22px;font-size:12.5px;color:var(--dim);line-height:1.75">
  <b>Countries:</b> {{ claim.markets | length }} &mdash; {% for m in claim.markets %}{{ m | upper }}{% if not loop.last %}, {% endif %}{% endfor %}<br>
  <b>Runs:</b> {% for r in claim.runs %}{{ r.run_id }}{% if not loop.last %} &middot; {% endif %}{% endfor %}<br>
  <b>Assistants:</b> {% for b in claim.chatbots %}{{ b | botName }}{% if not loop.last %}, {% endif %}{% endfor %}<br>
  <b>Per run:</b> {{ claim.runs[0].prompts }} prompts &times; {{ claim.runs[0].models | length }} assistants
    &times; {{ claim.runs[0].repeats }} repeats<br>
  <b>Versions:</b> catalog {{ claim.runs[0].versions.catalog }} &middot; grid {{ claim.runs[0].versions.grid }}
    &middot; judge {{ claim.runs[0].versions.judge }} &middot; watchlist {{ claim.runs[0].versions.watchlist }}<br>
  <b>Judge validation:</b> {{ claim.runs[0].judge_validation.status }}
</div>
{%- endif %}

{%- if claim.limitations %}
<h3 class="ssub" id="limitations" style="margin-top:26px">What this page cannot tell you</h3>
<p class="note">Generated from the run itself, not written by hand.</p>
<div class="panel" style="padding:16px 18px">
  <ul style="margin:0;padding-left:18px;font-size:13.5px;line-height:1.7">
    <li><b>Judge validation {{ claim.limitations.judge.status }}.</b> Until agreement between the judge and
      human coders is reported, every content verdict on this page is provisional.</li>
    <li><b>All {{ claim.limitations.lowCells }} of {{ claim.limitations.cells }} assistant × question-type
      cells are below n = {{ metrics.lowN }}</b> ({{ claim.limitations.repeats }} repeats × four wordings
      = {{ claim.limitations.repeats * 4 }} answers each) and are shown greyed. At claim level this page
      describes direction, not significance; significance is tested where cells pool across the cluster.</li>
    <li>{{ claim.limitations.unresolved }} {{ claim.limitations.unresolved | plural("answer", "answers") }}
      unresolved and {{ claim.limitations.quarantined }} quarantined, excluded from every figure.
      {{ claim.limitations.missing }} expected {{ claim.limitations.missing | plural("answer", "answers") }} not collected.</li>
    <li>{{ claim.limitations.reviewed }} of {{ claim.limitations.needsReview }} answers flagged for human
      review have been reviewed.</li>
    {%- if claim.limitations.stability %}
    <li>Mean stability {{ claim.limitations.stability | round(2) }} across
      {{ claim.limitations.repeats }} repeats, with {{ claim.limitations.unstable }} prompt × assistant
      pairs giving three different verdicts. A single-shot audit of this claim would have been unreliable.</li>
    {%- endif %}
    <li>Collected <time datetime="{{ claim.limitations.window[0] | isoDate }}">{{ claim.limitations.window[0] | displayDate }}</time>
      to <time datetime="{{ claim.limitations.window[1] | isoDate }}">{{ claim.limitations.window[1] | displayDate }}</time>.
      Assistants change with model updates; these figures describe that window.</li>
    {%- if claim.limitations.live %}
    <li>{{ claim.limitations.live }} live-formulation answers, too few to detect an artefact of our own wording.</li>
    {%- endif %}
  </ul>
</div>
{%- endif %}

{%- if claim.tested %}
<h3 class="ssub" id="method" style="margin-top:26px">How the measurement was made</h3>
<div class="prose" style="max-width:none">
  <p>Each claim is tested with {{ claim.runs[0].prompts }} prompts per run: four question types &mdash;
    neutral, news-style, leading, and a request to write it up &mdash; times four wordings, authored in the
    language of each market rather than translated. Every prompt goes to every assistant
    {{ claim.runs[0].repeats }} times through the public consumer interface, not the API.</p>
  <p>Each answer is coded twice, independently. What the assistant did with the claim is coded by an LLM
    judge over three passes with a majority vote, and every repeat is put to a person. Whether any cited
    domain is on a versioned watchlist is a separate, mechanical check that forms no opinion about why the
    domain was cited. The intersection of the two gives the escalation tier.</p>
  <p>The repeat rate divides by substantive answers, with refusals removed; the contamination rate and the
    verdict distribution divide by all valid answers. Every share carries a Wilson 95% interval, cells under
    n = {{ metrics.lowN }} are flagged, and no figure is ever aggregated across question types, markets or
    runs. Versions of the catalog, prompt grid, judge and watchlist are frozen per run and printed in the
    record above.</p>
</div>
{%- endif %}

{%- if claim.tested %}
{%- if claim.liveComparison | length %}
<h3 class="ssub" id="live-vs-grid" style="margin-top:26px">A check on our own wording: live questions against our grid</h3>
<p class="note">A check on our own method: the same claim asked in the words people
  actually use, set against our designed questions. If the two disagree, our questions are shaping the
  result. The two are reported side by side and never pooled.</p>
{%- for block in claim.liveComparison %}
<div class="panel"><table>
  <caption class="visually-hidden">Repeat rate on live formulations against the constructed grid, {{ block.run.country | countryName }}</caption>
  <thead><tr><th scope="col">{{ 'col.chatbot' | t }}</th><th scope="col" class="num">Grid ({{ 'P2' }})</th>
    <th scope="col" class="num">Live</th><th scope="col">Agreement</th></tr></thead>
  <tbody>
  {%- for row in block.rows %}
    <tr data-persona="P2">
      <th scope="row" style="font-weight:400">{{ row.chatbot | botName }}</th>
      <td class="num"><span class="cellstat{% if row.grid.low_n %} lown{% endif %}">{{ row.grid.rate | rate }}<small>{{ row.grid.ci | ciLabel }} &middot; n={{ row.grid.n }}</small></span></td>
      <td class="num"><span class="cellstat{% if row.live.low_n %} lown{% endif %}">{{ row.live.rate | rate }}<small>{{ row.live.ci | ciLabel }} &middot; n={{ row.live.n }}</small></span></td>
      <td style="color:var(--dim);font-size:12.5px">{% if row.agree and row.agree.significant %}<b style="color:var(--false)">they differ</b>{% else %}agrees directionally &middot; low n{% endif %}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endfor %}
<p class="note">At these sample sizes the live intervals are wide, so this section can neither confirm nor
  rule out an artefact of our own wording. It is reported as it stands.</p>
{%- endif %}
{%- endif %}

{%- if claim.tested %}</div>{% endif %}

{%- if claim.changelog | length %}
<h2 id="changelog">{{ 'claim.changelog' | t }}</h2>
<div class="panel"><table>
  <caption class="visually-hidden">What changed on this page, and when</caption>
  <tbody>
  {%- for entry in claim.changelog %}
    <tr><th scope="row" class="num" style="color:var(--dimmer);width:1%;white-space:nowrap;font-weight:500"><time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time></th>
      <td style="color:var(--dim)">{{ entry.note_en }}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

<div class="exports" style="margin:28px 0 40px">

  <a href="{{ ('/registry/' + claim.slug + '.json') | url }}">{{ 'claim.getJson' | t }}</a><span>&middot;</span>
  <a href="{{ ('/registry/' + claim.slug + '.md') | url }}">{{ 'claim.getMarkdown' | t }}</a>
  {%- if navigation.has.data %}<span>&middot;</span><a href="{{ '/data/#cite' | url }}">{{ 'claim.cite' | t }}</a>{% endif %}
</div>
</div>
