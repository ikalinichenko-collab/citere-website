{
  "ci": {
    "collect": {
      "staticDistDir": "_site-lighthouse",
      "url": [
        "http://localhost/index.html",
        "http://localhost/registry/index.html",
        "http://localhost/registry/c1-003-ukrainian-officials-stole-100-million-of-western/index.html",
        "http://localhost/registry/c1-003-ukrainian-officials-stole-100-million-of-western/escalation/index.html",
        "http://localhost/benchmarks/index.html",
        "http://localhost/sources/index.html",
        "http://localhost/sources/pravda-de-example/index.html",
        "http://localhost/countermeasures/index.html",
        "http://localhost/countries/index.html",
        "http://localhost/countries/full/index.html",
        "http://localhost/countries/us/index.html",
        "http://localhost/platforms/perplexity/index.html",
        "http://localhost/data/index.html",
        "http://localhost/monitor/2026-09-monitor/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
